{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "src/cli/index.ts",
    "src/action/index.ts",
    "scripts/*.mjs",
    "tests/**/*.test.ts",
    "tests/benchmark/**/*.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["dist/**"],
  "ignoreBinaries": ["mkdocs"]
}
