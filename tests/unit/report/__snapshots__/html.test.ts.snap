// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HTML report > renders a stable standalone report snapshot 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BoardReadyOps Report</title>
  <style>
    :root {
      color-scheme: light;
      --background: #f7f9fb;
      --surface: #ffffff;
      --text: #1b2430;
      --muted: #566477;
      --border: #cfd7e2;
      --accent: #0b5cad;
      --critical: #b42318;
      --high: #b54708;
      --medium: #7a5c00;
      --low: #0f766e;
      --info: #175cd3;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.5;
    }

    a {
      color: var(--accent);
    }

    header,
    main {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    header {
      padding: 32px 0 16px;
    }

    h1,
    h2,
    h3 {
      margin: 0;
      line-height: 1.2;
    }

    h1 {
      font-size: 2rem;
    }

    h2 {
      margin: 32px 0 12px;
      font-size: 1.35rem;
    }

    h3 {
      margin: 16px 0 8px;
      font-size: 1rem;
    }

    .metadata {
      margin: 8px 0 0;
      color: var(--muted);
    }

    .summary-grid,
    .breakdown-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }

    .metric,
    .panel {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      padding: 14px;
    }

    .metric strong {
      display: block;
      font-size: 1.8rem;
    }

    .metric span,
    .empty,
    .muted {
      color: var(--muted);
    }

    .filter-bar {
      position: sticky;
      top: 0;
      z-index: 2;
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      align-items: end;
      margin: 24px 0 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.96);
      padding: 12px;
      box-shadow: 0 6px 16px rgba(20, 31, 46, 0.08);
    }

    label {
      display: grid;
      gap: 4px;
      font-weight: 700;
    }

    select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      padding: 8px;
      font: inherit;
    }

    .count {
      align-self: center;
      color: var(--muted);
      font-weight: 700;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid var(--border);
      background: var(--surface);
    }

    caption {
      padding: 10px 0;
      text-align: left;
      font-weight: 700;
    }

    th,
    td {
      border-top: 1px solid var(--border);
      padding: 10px;
      text-align: left;
      vertical-align: top;
    }

    thead th {
      border-top: 0;
      background: #eef3f8;
    }

    code {
      overflow-wrap: anywhere;
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
      font-size: 0.92em;
    }

    .badge {
      display: inline-block;
      min-width: 72px;
      border-radius: 999px;
      padding: 2px 9px;
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 800;
      text-align: center;
    }

    .severity-critical {
      background: var(--critical);
    }

    .severity-high {
      background: var(--high);
    }

    .severity-medium {
      background: var(--medium);
    }

    .severity-low {
      background: var(--low);
    }

    .severity-info {
      background: var(--info);
    }

    details {
      margin-top: 8px;
    }

    summary {
      cursor: pointer;
      font-weight: 700;
    }

    .detail-grid {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      margin-top: 10px;
    }

    ol,
    ul {
      margin: 6px 0 0;
      padding-left: 22px;
    }

    pre {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: #f2f5f8;
      padding: 10px;
    }

    @media (max-width: 760px) {
      header,
      main {
        width: min(100% - 20px, 1180px);
      }

      table,
      thead,
      tbody,
      th,
      td,
      tr {
        display: block;
      }

      thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      tr {
        border-top: 1px solid var(--border);
      }

      td {
        border-top: 0;
      }

      td::before {
        display: block;
        color: var(--muted);
        content: attr(data-label);
        font-size: 0.82rem;
        font-weight: 700;
      }
    }

    @media print {
      body {
        background: #ffffff;
      }

      .filter-bar {
        position: static;
        box-shadow: none;
      }

      select,
      script {
        display: none;
      }

      a {
        color: #000000;
        text-decoration: underline;
      }
    }
  </style>
</head>
<body>
  <header>
    <h1>BoardReadyOps Report</h1>
    <p class="metadata">Generated 2026-05-22T00:00:00.000Z by boardreadyops 1.0.2. Threshold failed.</p>
  </header>
  <main>
    <section aria-labelledby="summary-heading">
      <h2 id="summary-heading">Summary by Severity</h2>
      <div class="summary-grid">
        <article class="metric">
          <strong>3</strong>
          <span>Total</span>
        </article>
        <article class="metric">
          <strong>1</strong>
          <span>critical</span>
        </article>
        <article class="metric">
          <strong>1</strong>
          <span>high</span>
        </article>
        <article class="metric">
          <strong>0</strong>
          <span>medium</span>
        </article>
        <article class="metric">
          <strong>0</strong>
          <span>low</span>
        </article>
        <article class="metric">
          <strong>1</strong>
          <span>info</span>
        </article>
      </div>
    </section>

    <section aria-labelledby="project-heading">
      <h2 id="project-heading">Per-project Breakdown</h2>
      <div class="breakdown-grid">
        <article class="panel">
          <h3><code>assembly/main.kicad_pro</code></h3>
          <p><strong>1</strong> finding</p>
          <p class="muted">1 high</p>
        </article>
        <article class="panel">
          <h3><code>fabrication/prototype.kicad_pro</code></h3>
          <p><strong>1</strong> finding</p>
          <p class="muted">1 critical</p>
        </article>
        <article class="panel">
          <h3><code>Unassigned</code></h3>
          <p><strong>1</strong> finding</p>
          <p class="muted">1 info</p>
        </article>
      </div>
    </section>

    <section aria-labelledby="rule-heading">
      <h2 id="rule-heading">Per-rule Grouping</h2>
      <table>
        <caption>Findings grouped by rule</caption>
        <thead>
          <tr><th scope="col">Rule</th><th scope="col">Total</th><th scope="col">Severity counts</th></tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Rule"><code>bom.missing-mpn</code></td>
            <td data-label="Total">1</td>
            <td data-label="Severity counts">1 high</td>
          </tr>
          <tr>
            <td data-label="Rule"><code>info.note</code></td>
            <td data-label="Total">1</td>
            <td data-label="Severity counts">1 info</td>
          </tr>
          <tr>
            <td data-label="Rule"><code>manufacturing.outputs-present</code></td>
            <td data-label="Total">1</td>
            <td data-label="Severity counts">1 critical</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section aria-labelledby="findings-heading">
      <h2 id="findings-heading">Findings</h2>
      <section class="filter-bar" aria-label="Filter findings">
        <label>Severity
          <select id="severity-filter" data-filter="severity">
            <option value="">All severities</option>
            <option value="critical">critical</option>
            <option value="high">high</option>
            <option value="info">info</option>
          </select>
        </label>
        <label>Rule
          <select id="rule-filter" data-filter="rule">
            <option value="">All rules</option>
            <option value="bom.missing-mpn">bom.missing-mpn</option>
            <option value="info.note">info.note</option>
            <option value="manufacturing.outputs-present">manufacturing.outputs-present</option>
          </select>
        </label>
        <label>Project
          <select id="project-filter" data-filter="project">
            <option value="">All projects</option>
            <option value="assembly/main.kicad_pro">assembly/main.kicad_pro</option>
            <option value="fabrication/prototype.kicad_pro">fabrication/prototype.kicad_pro</option>
            <option value="Unassigned">Unassigned</option>
          </select>
        </label>
        <output class="count" id="visible-count" aria-live="polite">3 findings</output>
      </section>
      <table id="findings-table">
        <caption>Filterable finding list</caption>
        <thead>
          <tr><th scope="col">Severity</th><th scope="col">Rule</th><th scope="col">Project</th><th scope="col">Finding</th></tr>
        </thead>
        <tbody>
          <tr data-severity="high" data-rule="bom.missing-mpn" data-project="assembly/main.kicad_pro">
            <td data-label="Severity"><span class="badge severity-high">high</span></td>
            <td data-label="Rule"><code>bom.missing-mpn</code></td>
            <td data-label="Project"><code>assembly/main.kicad_pro</code></td>
            <td data-label="Finding">
              R1 is missing an MPN.
              <details>
                <summary>Details</summary>
                <div class="detail-grid">
                  <section>
                    <h3>Resource</h3>
                    <p><code>bom.csv</code> <span class="muted">(bom)</span></p>
                    <p>line 2, column 1</p>
                  </section>
                  <section>
                    <h3>Context</h3>
                    <p>Confidence: high</p>
                    <pre><code>{
  &quot;reference&quot;: &quot;R1&quot;
}</code></pre>
                  </section>
                  <section>
                    <h3>Fix</h3>
                    <p>Add manufacturer part numbers.</p>
                    <ol><li>Populate the MPN column.</li><li>Re-run the BOM check.</li></ol>
                  </section>
                  <section>
                    <h3>References</h3>
                    <ul><li><a href="https://github.com/oaslananka/boardreadyops/blob/main/docs/rules/bom.md">https://github.com/oaslananka/boardreadyops/blob/main/docs/rules/bom.md</a></li><li><a href="https://example.test/mpn">https://example.test/mpn</a></li></ul>
                  </section>
                </div>
              </details>
            </td>
          </tr>
          <tr data-severity="critical" data-rule="manufacturing.outputs-present" data-project="fabrication/prototype.kicad_pro">
            <td data-label="Severity"><span class="badge severity-critical">critical</span></td>
            <td data-label="Rule"><code>manufacturing.outputs-present</code></td>
            <td data-label="Project"><code>fabrication/prototype.kicad_pro</code></td>
            <td data-label="Finding">
              Gerber outputs are missing.
              <details>
                <summary>Details</summary>
                <div class="detail-grid">
                  <section>
                    <h3>Resource</h3>
                    <p><code>fabrication/</code> <span class="muted">(manifest)</span></p>
                    <p class="muted">No location provided.</p>
                  </section>

                  <section>
                    <h3>Fix</h3>
                    <p>Generate fabrication outputs before release.</p>
                    <ol><li>Open KiCad Plot.</li><li>Export Gerbers and drill files.</li></ol>
                  </section>
                  <section><h3>References</h3><p class="muted">No references provided.</p></section>
                </div>
              </details>
            </td>
          </tr>
          <tr data-severity="info" data-rule="info.note" data-project="Unassigned">
            <td data-label="Severity"><span class="badge severity-info">info</span></td>
            <td data-label="Rule"><code>info.note</code></td>
            <td data-label="Project"><code>Unassigned</code></td>
            <td data-label="Finding">
              Lifecycle source was unavailable.
              <details>
                <summary>Details</summary>
                <div class="detail-grid">
                  <section>
                    <h3>Resource</h3>
                    <p><code>bom.csv</code> <span class="muted">(bom)</span></p>
                    <p class="muted">No location provided.</p>
                  </section>

                  <section><h3>Fix</h3><p class="muted">No fix suggestion provided.</p></section>
                  <section><h3>References</h3><p class="muted">No references provided.</p></section>
                </div>
              </details>
            </td>
          </tr>
        </tbody>
      </table>
    </section>
  </main>
  <script>
    "use strict";
    const filters = Array.from(document.querySelectorAll("[data-filter]"));
    const rows = Array.from(document.querySelectorAll("#findings-table tbody tr"));
    const counter = document.getElementById("visible-count");
    const plural = (count) => count === 1 ? "finding" : "findings";
    const applyFilters = () => {
      const active = Object.fromEntries(filters.map((filter) => [filter.dataset.filter, filter.value]));
      let visible = 0;
      for (const row of rows) {
        const matched = (!active.severity || row.dataset.severity === active.severity)
          && (!active.rule || row.dataset.rule === active.rule)
          && (!active.project || row.dataset.project === active.project);
        row.hidden = !matched;
        if (matched) {
          visible += 1;
        }
      }
      if (counter) {
        counter.value = visible + " " + plural(visible);
        counter.textContent = counter.value;
      }
    };
    for (const filter of filters) {
      filter.addEventListener("change", applyFilters);
    }
  </script>
</body>
</html>
"
`;
