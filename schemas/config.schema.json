{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oaslananka/boardreadyops/schemas/config-v1.json",
  "title": "BoardReadyOps configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": ["warn", "enforce"]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": ["warn", "enforce"]
          },
          "pinmap": {
            "type": "string"
          },
          "bom": {
            "type": "string"
          },
          "rules": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "severity": {
                      "enum": ["critical", "high", "medium", "low", "info"]
                    },
                    "severity-overrides": {
                      "type": "object",
                      "additionalProperties": {
                        "enum": ["critical", "high", "medium", "low", "info"]
                      }
                    },
                    "ignore-refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "required": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "bom": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "severity": {
                "enum": ["critical", "high", "medium", "low", "info"]
              },
              "severity-overrides": {
                "type": "object",
                "additionalProperties": {
                  "enum": ["critical", "high", "medium", "low", "info"]
                }
              },
              "ignore-refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "patterns": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "fail-on": {
      "enum": ["critical", "high", "medium", "low", "never"]
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fail-on": {
            "enum": ["critical", "high", "medium", "low", "never"]
          },
          "require": {
            "type": "array",
            "items": {
              "enum": [
                "clean-drc",
                "clean-erc",
                "gerber",
                "drill",
                "position",
                "bom",
                "changelog",
                "tagged-release",
                "no-eol-components"
              ]
            }
          }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "reason"],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "format": "date"
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "mode"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["new-only", "all"]
        }
      }
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "notifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slack": {
          "$ref": "#/$defs/webhookNotifier"
        },
        "teams": {
          "$ref": "#/$defs/webhookNotifier"
        },
        "discord": {
          "$ref": "#/$defs/webhookNotifier"
        },
        "telegram": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "botTokenEnv": {
              "type": "string",
              "minLength": 1
            },
            "chatId": {
              "type": "string",
              "minLength": 1
            },
            "minSeverity": {
              "$ref": "#/$defs/severity"
            }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "smtpEnv": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "string",
              "minLength": 1
            },
            "recipients": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "minSeverity": {
              "$ref": "#/$defs/severity"
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sarif": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            }
          ]
        },
        "json": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            }
          ]
        },
        "markdown": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            }
          ]
        },
        "junit": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            }
          ]
        },
        "html": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "const": false
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "severity": {
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "webhookNotifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webhookEnv": {
          "type": "string",
          "minLength": 1
        },
        "minSeverity": {
          "$ref": "#/$defs/severity"
        }
      }
    }
  }
}
